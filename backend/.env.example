# The backend reads real environment variables (it does not load .env files).
# Copy these into your shell/service configuration as needed.

# Where jobs are stored (one sub-folder per job).
DATA_DIR=./data/jobs

# Frontend origin(s) allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:5173

# Extraction jobs that run at the same time (1 = one at a time).
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=20

# 0 = never delete old jobs automatically.
DATA_RETENTION_DAYS=0

# Hostnames accepted in submitted URLs.
ALLOWED_HOSTS=readawrite.com,www.readawrite.com

# Safety limits (seconds).
CANCEL_GRACE_SECONDS=900
JOB_MAX_RUNTIME_SECONDS=21600

# Advanced: path to the pipeline script and the Python used to run it.
# PIPELINE_SCRIPT=../pipeline.py
# PYTHON_EXECUTABLE=python

# --- Sessions and automatic cleanup -------------------------------------
# The page sends a heartbeat this often (seconds).
SESSION_HEARTBEAT_SECONDS=60
# A session with no heartbeat for this long is expired and its data removed.
SESSION_IDLE_TIMEOUT_SECONDS=900
# After the page says it is closing, a heartbeat within this window reopens
# the session (this is what makes a page refresh keep its session).
SESSION_CLOSE_GRACE_SECONDS=30
# Background sweep interval in seconds (0 = off; rely on the other triggers).
SESSION_SWEEP_SECONDS=30
# Set a secret to enable POST /api/internal/cleanup for an external scheduler
# (e.g. Cloud Scheduler on scale-to-zero hosting). Empty = endpoint disabled.
CLEANUP_TOKEN=

# --- Optional cloud storage cleanup (Google Cloud Storage) --------------
# STORAGE_BACKEND=gcs
# GCS_BUCKET=my-bucket
# GCS_PREFIX=jobs
